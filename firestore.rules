// Reguły Firestore dla synchronizacji — wklej w Firebase Console -> Firestore Database -> Rules -> Publish.
// - odczyt tylko po dokładnym kodzie (get), bez listowania wszystkich dokumentów,
// - kod (id dokumentu) musi mieć min. 20 znaków, więc nie da się go odgadnąć,
// - dokument ma dozwolony tylko kształt: tickers, transactions (tekst), updatedAt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /watchlists/{code} {
      allow get: if code.size() >= 20;
      allow list: if false;
      allow delete: if false;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['tickers', 'transactions', 'updatedAt'])
        && request.resource.data.tickers is list
        && request.resource.data.tickers.size() <= 100
        && (!('transactions' in request.resource.data)
            || (request.resource.data.transactions is string
                && request.resource.data.transactions.size() < 200000));
    }
  }
}
